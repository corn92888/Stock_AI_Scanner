TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID="@your_channel_username_or_chat_id"

# Anthropic Claude API Key (用於執行 llm_agent.py 做新聞雙重質化分析)
# 可至 Anthropic Console 申請: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Server-only Supabase credentials for portfolios, market context, and the
# verified scanner evidence store. Never expose the service-role key in web code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Start in dual_write. Change to cloud_primary only after the machine-readable
# cutover audit reports READY; cloud_primary makes cloud restore/push mandatory.
CLOUD_EVIDENCE_MODE="dual_write"
CLOUD_EVIDENCE_REQUIRED="false"
CLOUD_EVIDENCE_RETENTION_DAYS="45"

# Intraday opening quotes can be sparse for a few minutes. Retries fetch only
# symbols that are still missing and never lower the 65% coverage safety gate.
INTRADAY_QUOTE_MAX_ATTEMPTS="3"
INTRADAY_QUOTE_RETRY_DELAY_SECONDS="45"
