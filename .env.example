TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID="@your_channel_username_or_chat_id"

# Anthropic Claude API Key (用於執行 llm_agent.py 做新聞雙重質化分析)
# 可至 Anthropic Console 申請: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Server-only Supabase credentials for portfolios, market context, and the
# verified scanner evidence store. Never expose the service-role key in web code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Keep false during dual-write validation. Change to true only after the cloud
# evidence status has remained verified and the Git database fallback is retired.
CLOUD_EVIDENCE_REQUIRED="false"
